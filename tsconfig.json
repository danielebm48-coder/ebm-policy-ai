{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["node", "react", "express", "body-parser"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "api/**/*.ts", "app/src/**/*.tsx"]
}
