{
  "name": "school-policy-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only api/start.ts",
    "dev:app": "vite",
    "build:api": "tsc --project tsconfig.json --outDir dist",
    "build:app": "vite build",
    "build": "npm run build:api && npm run build:app",
    "start": "cross-env NODE_ENV=production node dist/api/start.js",
    "test:db": "ts-node src/db-test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "@types/multer": "^2.1.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.18.0"
  },
  "devDependencies": {
    "@types/body-parser": "*",
    "@types/cors": "*",
    "@types/express": "*",
    "@types/node": "*",
    "@types/pdf-parse": "^1.1.4",
    "@types/mammoth": "^1.1.2",
    "@types/pg": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@types/react-router-dom": "*",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.14"
  }
}
