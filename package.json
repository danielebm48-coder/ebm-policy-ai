    "express": "^4.18.2",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/pg": "^8.10.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
